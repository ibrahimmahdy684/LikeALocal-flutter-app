rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function databaseSeeded() {
      return exists(/databases/$(database)/documents/meta/seed);
    }

    match /meta/seed {
      allow read: if true;
      allow create: if !databaseSeeded();
    }

    match /cities/{cityId} {
      allow read: if true;
      allow create: if !databaseSeeded();
      allow update, delete: if request.auth != null;
    }

    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /places/{placeId} {
      allow read: if resource.data.isApproved == true
        || (request.auth != null && request.auth.uid == resource.data.contributorId);
      allow create: if (!databaseSeeded() && request.resource.data.isApproved == true)
        || (request.auth != null
            && request.resource.data.contributorId == request.auth.uid);
      allow update, delete: if request.auth != null
        && request.auth.uid == resource.data.contributorId;

      match /comments/{commentId} {
        allow read: if true;
        allow create: if request.auth != null
          && request.resource.data.userId == request.auth.uid;
        allow update, delete: if request.auth != null
          && request.auth.uid == resource.data.userId;
      }
    }

    match /cityChats/{cityId}/messages/{messageId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid;
      allow update, delete: if request.auth != null
        && request.auth.uid == resource.data.userId;
    }

    match /notifications/{notificationId} {
      allow read, update, delete: if request.auth != null
        && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid;
    }
  }
}
